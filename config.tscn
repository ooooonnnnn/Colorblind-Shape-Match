[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 34
theme_override_constants/margin_bottom = 34

[node name="Page" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TopBar" type="HBoxContainer" parent="Margin/Page"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_override_constants/separation = 20

[node name="Back" type="Button" parent="Margin/Page/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
tooltip_text = "Back to the menu (unsaved changes are dropped)"
script = ExtResource("3_toy_button")
